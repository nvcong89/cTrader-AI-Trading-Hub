# Qwen / OpenAI-compatible API Configuration Template
# Copy this file to API_key.env and fill in your actual credentials

# Endpoint (Default: DashScope International - https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
OpenAI_compatible=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Your Qwen / OpenAI-compatible API Key
APIKey=sk-your-api-key-here