[Unit]
Description=cTrader AI Trading Hub FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ctrader-ai-hub
Environment="PYTHONUNBUFFERED=1"
Environment="HEADLESS=True"
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/share/dotnet"
Environment="DOTNET_ROOT=/usr/share/dotnet"
Environment="DOTNET_ROLL_FORWARD=Major"
ExecStart=/opt/ctrader-ai-hub/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8181 --log-level info --access-log
Restart=always
RestartSec=5s

# Resource limits & safety
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
